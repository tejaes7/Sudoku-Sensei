# Copy this file to .env and fill in your key. Any OpenAI-compatible provider works.
# Leave AI_TEACHER_API_KEY empty to run the AI Teacher on the CSP engine alone (offline).

AI_TEACHER_API_KEY=

# OpenAI
AI_TEACHER_BASE_URL=https://api.openai.com/v1
AI_TEACHER_MODEL=gpt-4o-mini

# Groq (free tier)
# AI_TEACHER_BASE_URL=https://api.groq.com/openai/v1
# AI_TEACHER_MODEL=openai/gpt-oss-120b

# Google Gemini
# AI_TEACHER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_TEACHER_MODEL=gemini-2.0-flash

# OpenRouter
# AI_TEACHER_BASE_URL=https://openrouter.ai/api/v1
# AI_TEACHER_MODEL=meta-llama/llama-3.3-70b-instruct
